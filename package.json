{
    "name": "project",
    "version": "1.0.0",
    "scripts": {
        "install-backend": "npm install --prefix server",
        "install-frontend": "npm install --prefix client",
        "install-all": "npm run install-backend && npm run install-frontend",
        "dev": "npx tsx watch server/src/app/server.ts",
        "build": "npm install --prefix server --include=dev && npm run build --prefix server",
        "start": "node server/dist/app/server.js"
    },
    "devDependencies": {
        "@types/node": "^26.0.1",
        "typescript": "^6.0.3"
    }
}